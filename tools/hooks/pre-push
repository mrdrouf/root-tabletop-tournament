#!/bin/sh
# Anonymity guard, installed 2026-09-05. The public mrdrouf repos must never receive
# anything that carries the maintainer's real identity. This blocks:
#   - pushing the local-only legacy/* and discarded/* tags (real-name history),
#   - any commit in the pushed range whose author, committer or message matches the pattern.
# Deletions are always allowed. Bypass only on purpose: git push --no-verify.
zero=0000000000000000000000000000000000000000
pattern='avernas|adrien'
status=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in
    refs/tags/legacy/*|refs/tags/discarded/*)
      echo "pre-push: BLOCKED $remote_ref -- local-only tag, never push it." >&2
      status=1; continue;;
  esac
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  # The version must not skip. "this number cannot be skipped its very important to keep track of
  # versions to keep track of buggs" -- a version has to name exactly one build, or a bug report
  # cannot be tied to one. Every commit bumps the minor; this refuses a range where one did not.
  if ! python3 "$(git rev-parse --show-toplevel)/tools/bump_version.py" --check-sequence "$range"; then
    echo "pre-push: BLOCKED $remote_ref -- see above." >&2
    status=1
  fi
  bad=$(git log --format='%h %an <%ae> %cn <%ce> %s%n%b' "$range" 2>/dev/null | grep -i -E "$pattern" | head -3)
  if [ -n "$bad" ]; then
    echo "pre-push: BLOCKED $remote_ref -- commits carry the real identity or name:" >&2
    echo "$bad" | cut -c1-120 >&2
    status=1
  fi
done
exit $status
